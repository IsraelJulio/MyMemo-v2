{
  "name": "mymemo-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:migrate": "node --use-system-ca ./node_modules/prisma/build/index.js migrate dev",
    "prisma:generate": "node --use-system-ca ./node_modules/prisma/build/index.js generate",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.10.0",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "multer": "^2.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.0.0",
    "prisma": "^6.10.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
