generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLAYER_ONE
  ISRAEL
}

enum Direction {
  FRONT
  BACK
}

enum GameMode {
  BASE
  SPACED_LIST
  SPACED_GLOBAL
  BASE_WRITTEN
  SPACED_LIST_WRITTEN
  SPACED_GLOBAL_WRITTEN
}

enum TranscriptionStatus {
  PENDING
  DOWNLOADING
  CONVERTING
  TRANSCRIBING
  SEGMENTING
  TRANSLATING
  COMPLETED
  FAILED
  CANCELED
}

model User {
  id                  String              @id @default(cuid())
  displayName         String              @unique
  role                Role                @unique
  attempts            Attempt[]
  sessions            GameSession[]
  goals               Goal[]
  achievementUnlocks  AchievementUnlock[]
  transcriptionJobs   TranscriptionJob[]
}

model StudyList {
  id        String        @id @default(cuid())
  title     String
  color     String        @default("#7c3aed")
  deletedAt DateTime?
  createdAt DateTime      @default(now())
  cards     Card[]
  sessions  GameSession[]
  goals     Goal[]
}

model Card {
  id        String     @id @default(cuid())
  listId    String
  front     String
  back      String
  createdAt DateTime   @default(now())
  list      StudyList  @relation(fields: [listId], references: [id], onDelete: Cascade)
  attempts  Attempt[]
}

model Attempt {
  id        String    @id @default(cuid())
  userId    String
  cardId    String
  sessionId String?
  direction Direction
  correct   Boolean
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
  card      Card      @relation(fields: [cardId], references: [id])
  session   GameSession? @relation(fields: [sessionId], references: [id])
}

model GameSession {
  id              String    @id @default(cuid())
  userId          String
  listId          String?
  listTitle       String
  mode            GameMode
  direction       Direction
  points          Float
  accuracy        Float
  correctCount    Int
  totalCount      Int
  longestStreak   Int
  antiGrind       Boolean   @default(false)
  playedAt        DateTime  @default(now())
  user            User      @relation(fields: [userId], references: [id])
  list            StudyList? @relation(fields: [listId], references: [id], onDelete: SetNull)
  attempts        Attempt[]
}

model Goal {
  id         String     @id @default(cuid())
  userId     String
  listId     String?
  target     Float
  achievedAt DateTime?
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id])
  list       StudyList? @relation(fields: [listId], references: [id], onDelete: Cascade)
}

model AchievementUnlock {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])

  @@unique([userId, achievementId])
}

model TranscriptionJob {
  id               String              @id @default(cuid())
  userId           String
  sourceUrl        String
  sourceUrlHash    String
  sourceTitle      String?
  sourceLanguage   String?
  detectedLanguage String?
  targetLanguage   String              @default("pt-BR")
  status           TranscriptionStatus @default(PENDING)
  progress         Int                 @default(0)
  errorMessage     String?
  createdAt        DateTime            @default(now())
  startedAt        DateTime?
  finishedAt       DateTime?

  user             User                @relation(fields: [userId], references: [id])
  blocks           TranscriptBlock[]

  @@index([userId])
  @@index([status])
  @@index([sourceUrlHash])
  @@index([createdAt])
}

model TranscriptBlock {
  id                 String           @id @default(cuid())
  transcriptionJobId String
  order              Int
  startMs            Int?
  endMs              Int?
  originalText       String
  translatedText     String?
  confidence         Float?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  job                TranscriptionJob @relation(fields: [transcriptionJobId], references: [id], onDelete: Cascade)

  @@index([transcriptionJobId])
  @@unique([transcriptionJobId, order])
}
